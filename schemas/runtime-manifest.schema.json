{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeManifest",
  "description": "Repo2Prod runtime plan built from deterministic workspace evidence. Note: some rules are enforced only by validateManifest in code and cannot be expressed in JSON Schema — unique service ids, unique env names, edge from/to referencing existing service ids, and exactly one service with id 'app'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stack", "services", "edges", "commands", "env"],
  "properties": {
    "version": {
      "const": 1
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "framework", "packageManager"],
      "properties": {
        "language":       { "type": ["string", "null"] },
        "framework":      { "type": ["string", "null"] },
        "packageManager": { "type": ["string", "null"] }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "image", "ports"],
        "properties": {
          "id":    { "type": "string", "minLength": 1 },
          "name":  { "type": "string", "minLength": 1 },
          "image": { "type": ["string", "null"] },
          "ports": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation"],
        "properties": {
          "from":     { "type": "string", "minLength": 1 },
          "to":       { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "start", "test", "healthcheck"],
      "properties": {
        "build":       { "type": ["string", "null"] },
        "start":       { "type": ["string", "null"] },
        "test":        { "type": ["string", "null"] },
        "healthcheck": { "type": ["string", "null"] }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "required"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "safe-inferred",
              "generated-local-secret",
              "generated-local-infrastructure",
              "user-secret-required",
              "optional-external"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
