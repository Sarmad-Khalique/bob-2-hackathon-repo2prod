{
  "name": "repo2prod",
  "displayName": "Repo2Prod",
  "description": "Orchestrates execution and verifies a reproducible local runtime for IBM Bob IDE.",
  "version": "0.0.1",
  "publisher": "repo2prod",
  "private": true,
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:repo2prod.startProductionization",
    "onCommand:repo2prod.verifyRuntime",
    "onCommand:repo2prod.prepareRepair",
    "onCommand:repo2prod.prepareCI",
    "onCommand:repo2prod.completeRun",
    "onCommand:repo2prod.resetRun",
    "onCommand:repo2prod.createBobSkillSmokeTest",
    "onCommand:repo2prod.installBobSkills"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repo2prod.startProductionization",
        "title": "Repo2Prod: Start Productionization"
      },
      {
        "command": "repo2prod.verifyRuntime",
        "title": "Repo2Prod: Verify Runtime"
      },
      {
        "command": "repo2prod.prepareRepair",
        "title": "Repo2Prod: Prepare Repair"
      },
      {
        "command": "repo2prod.prepareCI",
        "title": "Repo2Prod: Prepare CI"
      },
      {
        "command": "repo2prod.completeRun",
        "title": "Repo2Prod: Complete Run"
      },
      {
        "command": "repo2prod.resetRun",
        "title": "Repo2Prod: Reset Run"
      },
      {
        "command": "repo2prod.createBobSkillSmokeTest",
        "title": "Repo2Prod: Create Bob Skill Smoke Test"
      },
      {
        "command": "repo2prod.installBobSkills",
        "title": "Repo2Prod: Install Bob Skills"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sarmad-Khalique/bob-2-hackathon-repo2prod.git"
  },
  "homepage": "https://github.com/Sarmad-Khalique/bob-2-hackathon-repo2prod#readme",
  "bugs": {
    "url": "https://github.com/Sarmad-Khalique/bob-2-hackathon-repo2prod/issues"
  }
}